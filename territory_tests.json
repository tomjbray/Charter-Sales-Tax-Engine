      "homeCountry": "ES",
      "origin": {"iata": "MAD", "country": "ES"},
      "destination": {"iata": "BCN", "country": "ES"},
      "expectedOriginTerritory": "ES_MAINLAND",
      "expectedDestinationTerritory": "ES_MAINLAND"
    },
    {
      "testId": "TERR-002",
